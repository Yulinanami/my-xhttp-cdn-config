# 主脚本
# 是否使用 xpadding 版主脚本，可填 true / false。
XPADDING_ENABLED="true"

# Reality 直连域名，必填。
REALITY_DOMAIN=""

# Cloudflare CDN 域名，必填。
CDN_DOMAIN=""

# VPS IP 类型：1 为 IPv4，2 为 IPv6。
IP_CHOICE="1"

# 回落方式：1 为 /var/www/dist/<域名> 静态页面，2 为 Nginx 反向代理。
FALLBACK_CHOICE="1"

# Reality 回落网站；FALLBACK_CHOICE="2" 时必填。
REALITY_FALLBACK_ORIGIN=""

# CDN 回落网站；FALLBACK_CHOICE="2" 时必填，不能与 Reality 回落网站相同。
CDN_FALLBACK_ORIGIN=""

# xpadding 使用的 HTTP Header；XPADDING_ENABLED="true" 时必填。
XHTTP_PADDING_HEADER="Referer"

# xpadding 使用的参数名；XPADDING_ENABLED="true" 时必填。
XHTTP_PADDING_KEY="x_padding"

# 是否为 CDN 节点启用 ECH；必须先启用 XPADDING_ENABLED。
CDN_ECH_ENABLED="false"

# 上下行不同 CDN
# 是否自动安装上下行不同 CDN 扩展。
DUAL_CDN_ENABLED="false"

# 是否复用主 CDN 节点的 ECH；DUAL_CDN_ENABLED="true" 时必填。
DUAL_CDN_REUSE_ECH="false"

# 上行 CDN 域名；DUAL_CDN_ENABLED="true" 时必填，可与主 CDN 域名相同。
CDN_A=""

# 下行 CDN 域名；DUAL_CDN_ENABLED="true" 时必填。
CDN_B=""

# CDN-A 回落网站；使用反向代理且 CDN_A 不是主 CDN 域名时必填。
CDN_A_FALLBACK_ORIGIN=""

# CDN-B 回落网站；使用反向代理且 CDN_B 是新增域名时必填。
CDN_B_FALLBACK_ORIGIN=""

# 上下行 IPv4 / IPv6
# 是否自动安装上下行 IPv4 / IPv6 扩展。
DUAL_IP_ENABLED="false"

# 指向 VPS IPv4 的 Reality 域名；DUAL_IP_ENABLED="true" 时必填。
REALITY_DOMAIN_V4=""

# 指向 VPS IPv6 的 Reality 域名；DUAL_IP_ENABLED="true" 时必填。
REALITY_DOMAIN_V6=""

# IPv4 Reality 回落网站；使用反向代理且域名不是主 Reality 域名时必填。
FALLBACK_ORIGIN_V4=""

# IPv6 Reality 回落网站；使用反向代理且域名不是主 Reality 域名时必填。
FALLBACK_ORIGIN_V6=""

# XHTTP H3
# 是否自动安装 XHTTP H3 扩展。
QUIC_ENABLED="false"

# 是否复用主 CDN 节点的 ECH；QUIC_ENABLED="true" 时必填。
QUIC_REUSE_ECH="false"

# XHTTP H3 UDP 监听端口，范围 1-65535，默认 443。
XHTTP_H3_PORT="443"

# Hysteria2
# 是否自动安装 Hysteria2 扩展。
HYSTERIA2_ENABLED="false"

# Hysteria2 UDP 监听端口，范围 1-65535，默认 8443。
HY2_PORT="8443"

# Hysteria2 密码；启用扩展时必填，仅支持字母、数字与 . _ ~ -。
HY2_PASSWORD=""
